# Copy to .env and fill in. Keep .env out of version control (it holds secrets).
# From your identity provider's app registration (OpenID Connect):
OIDC_ISSUER_URL=https://login.microsoftonline.com/YOUR-TENANT-ID/v2.0
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# 32 random bytes, base64: python -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
COOKIE_SECRET=
# Who may sign in, e.g. youruniversity.edu (comma-separated; * allows anyone your provider lets sign in)
ALLOWED_EMAIL_DOMAINS=
# The address people use, e.g. https://fraudlab.youruniversity.edu
PUBLIC_URL=
